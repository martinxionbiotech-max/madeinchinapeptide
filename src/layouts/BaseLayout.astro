---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { products, categories, type Category } from '../data/products';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  lang?: 'en' | 'es' | 'ar' | 'pt';
  alternates?: { hreflang: string; href: string }[];
}
const { title, description = site.description, canonical, noindex = false, lang = 'en', alternates = [] } = Astro.props;
const canonicalUrl = canonical ? `${site.url}${canonical}` : new URL(Astro.url.pathname, site.url).href;

// One BreadcrumbList for every page. Visual breadcrumbs use <Breadcrumbs>;
// this keeps the schema complete even on pages that only render a text crumb.
const pathname = Astro.url.pathname;
const langPrefix = pathname.match(/^\/(es|pt|ar)(\/|$)/)?.[1] as 'es' | 'pt' | 'ar' | undefined;
const labels = langPrefix === 'es'
  ? { home: 'Inicio', products: 'Productos', knowledge: 'Conocimiento', compare: 'Comparar' }
  : langPrefix === 'pt'
  ? { home: 'Início', products: 'Produtos', knowledge: 'Conhecimento', compare: 'Comparar' }
  : langPrefix === 'ar'
  ? { home: 'الرئيسية', products: 'المنتجات', knowledge: 'المعرفة', compare: 'مقارنة' }
  : { home: 'Home', products: 'Products', knowledge: 'Knowledge', compare: 'Compare' };
const cleanLabel = (s: string) => s.replace(/\s*[|—]\s*Made in China Peptide\s*$/i, '').replace(/\s*[|—]\s*MICP\s*$/i, '').trim();
const crumbs: { name: string; item: string }[] = [{ name: labels.home, item: `${site.url}/` }];
const segs = pathname.split('/').filter(Boolean);
const rest = langPrefix ? segs.slice(1) : segs;
const base = langPrefix ? `/${langPrefix}` : '';
const add = (name: string, path: string) => crumbs.push({ name, item: `${site.url}${path.startsWith('/') ? path : '/' + path}` });
if (rest[0] === 'products') {
  add(labels.products, `${base}/products/`);
  const cat = rest[1] as Category | undefined;
  if (cat && categories[cat]) {
    add(categories[cat].name, `${base}/products/${cat}/`);
    if (rest[2]) {
      const p = products.find((x) => x.slug === rest[2] && x.category === cat);
      if (p) add(p.name, `${base}/products/${cat}/${p.slug}/`);
      else add(cleanLabel(title), pathname);
    }
  }
} else if (rest[0] === 'knowledge') {
  add(labels.knowledge, `${base}/knowledge/`);
  if (rest[1]) add(cleanLabel(title), `${base}/knowledge/${rest[1]}/`);
} else if (rest[0] === 'compare') {
  add(labels.compare, `${base}/compare/`);
  if (rest[1]) add(cleanLabel(title), `${base}/compare/${rest[1]}/`);
} else if (pathname !== '/') {
  add(cleanLabel(title), pathname);
}
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.item })),
};

// Keep <title> within the 60-character SERP budget without breaking words.
function fitTitle(text: string): string {
  if (text.length <= 60) return text;
  const cut = text.slice(0, 59);
  const space = cut.lastIndexOf(' ');
  return `${(space > 25 ? cut.slice(0, space) : cut).trimEnd()}…`;
}
function fitDescription(text: string): string {
  if (text.length <= 155) return text;
  const cut = text.slice(0, 154);
  const space = cut.lastIndexOf(' ');
  return `${(space > 80 ? cut.slice(0, space) : cut).trimEnd()}…`;
}
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.brand,
  url: site.url,
  description: site.description,
  email: site.email,
  logo: { '@type': 'ImageObject', url: `${site.url}/images/logo.png`, width: 512, height: 512 },
  image: `${site.url}/images/logo.png`,
  areaServed: 'Worldwide',
  knowsAbout: ['Research peptides', 'Peptide synthesis', 'Lyophilized peptides', 'Bulk peptide supply', 'Peptide OEM'],
};
const webSiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: site.brand,
  publisher: { '@id': `${site.url}/#organization` },
};
---
<!doctype html>
<html lang={lang} dir={lang === "ar" ? "rtl" : "ltr"}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fitTitle(title)}</title>
  <meta name="description" content={fitDescription(description)} />
  <link rel="canonical" href={canonicalUrl} />
  {alternates.map(a => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.brand} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={`${site.url}/images/og-default.png`} />
  <meta property="og:image" content={`${site.url}/images/og-default.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${site.brand} — research peptide supply`} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0d1f33" />
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(webSiteLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</head>
<body>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <a class="wa-float" href={site.whatsappLink} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">💬 WhatsApp</a>
</body>
</html>
