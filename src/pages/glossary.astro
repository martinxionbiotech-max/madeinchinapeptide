---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleSchema from '../components/ArticleSchema.astro';

const groups = [
  {
    name: 'Analytical & quality',
    terms: [
      ['HPLC', 'High-performance liquid chromatography. Separates components of a sample and reports area percentages at a chosen wavelength; the basis of most peptide purity figures.', '/knowledge/how-to-verify-peptide-purity/'],
      ['Chromatogram', 'The plotted output of an HPLC run. Look at peak shape, baseline and impurity peaks, not only the main-peak percentage.', '/knowledge/peptide-coa-red-flags/'],
      ['Mass spectrometry (MS)', 'Measures molecular mass to confirm identity. An MS result supports “this is the right molecule”; it does not by itself prove purity.', '/quality/testing-methods/'],
      ['Sequence', 'The order of amino acid residues from the N-terminus to the C-terminus, written in one-letter code. Direction, terminal groups and modifications are part of the identity, not decoration.', '/knowledge/peptide-sequence-notation/'],
      ['Residue mass', 'The mass of an amino acid after it has lost water forming the peptide bond. A peptide\'s free-acid mass is the sum of residue masses plus one water molecule.', '/knowledge/peptide-sequence-notation/'],
      ['Monoisotopic mass', 'Mass calculated from the single most abundant isotope of each element. It differs from average mass, and the gap grows with molecule size.', '/knowledge/peptide-sequence-notation/'],
      ['b and y ions', 'The two backbone fragment series used to read a peptide sequence in tandem MS. A b ion is an N-terminal fragment plus a proton; a y ion is a C-terminal fragment plus water and a proton.', '/knowledge/peptide-ms-ms-sequence-confirmation/'],
      ['Sequence coverage', 'The share of backbone positions supported by observed fragment ions in an MS/MS experiment. A high percentage can still hide an unconfirmed stretch in the middle of the sequence.', '/knowledge/peptide-ms-ms-sequence-confirmation/'],
      ['Isobaric residues', 'Different residues with the same mass — leucine and isoleucine most notably. Mass alone cannot distinguish them, and standard CID fragmentation usually cannot either.', '/knowledge/peptide-ms-ms-sequence-confirmation/'],
      ['Stability study', 'A protocol that measures defined attributes over time at stated storage conditions. Real-time data support a shelf life; accelerated data describe degradation pathways.', '/knowledge/peptide-stability-studies/'],
      ['Purity vs assay', 'Purity is the share of the main peak by a given method. Assay is the quantity of the target compound measured against a standard. They are not interchangeable.', '/knowledge/how-to-verify-peptide-purity/'],
      ['Related impurity', 'A molecule close in structure to the target — a deletion, truncation or oxidation product. Its profile matters more than a single purity number.', '/knowledge/peptide-lot-consistency/'],
      ['Karl Fischer titration', 'The standard method for water content in a lyophilized cake. Residual moisture affects stability and cake integrity.', '/quality/testing-methods/'],
      ['Net peptide content', 'The mass fraction of a powder that is peptide, excluding counter-ion, water and residual salts. Different from HPLC purity.', '/knowledge/peptide-net-content-and-cost/'],
      ['Fill weight', 'The total powder mass in a vial. It includes the counter-ion and residual moisture, so it is not the mass of peptide.', '/knowledge/peptide-net-content-and-cost/'],
      ['Amino-acid analysis (AAA)', 'Hydrolysis of a sample to free amino acids, followed by separation and quantification. A primary method for peptide content.', '/knowledge/peptide-net-content-and-cost/'],
      ['Mass balance', 'Estimating peptide content by subtracting water, counter-ion and residual solvents from 100%. Only as good as the subtracted assays.', '/knowledge/peptide-net-content-and-cost/'],
      ['Extinction coefficient', 'The molar absorptivity used to convert an absorbance reading into a concentration (M⁻¹cm⁻¹). For peptides it is estimated from Trp, Tyr and cystine content.', '/knowledge/peptide-concentration-measurement/'],
      ['Beer–Lambert law', 'A = ε·c·l: absorbance is proportional to concentration and path length. It holds only for dilute solutions without scattering.', '/knowledge/peptide-concentration-measurement/'],
      ['BCA assay', 'A colorimetric protein/peptide assay based on copper reduction. Sequence-dependent and incompatible with reducing agents such as DTT.', '/knowledge/peptide-concentration-measurement/'],
      ['qNMR', 'Quantitative nuclear magnetic resonance against an internal standard. A primary concentration method when the compound is soluble and a signal is resolvable.', '/knowledge/peptide-concentration-measurement/'],
      ['COA (certificate of analysis)', 'The lot-specific document stating test methods, results and specification limits. It must reference the batch it belongs to.', '/quality/coa/'],
      ['Retention sample', 'Material held back from a lot for later comparison or retest. Ask for it contractually; it is the cheapest dispute tool you have.', '/knowledge/peptide-procurement-contract-terms/'],
      ['Specification', 'The written set of limits and methods a lot must meet. A product name is not a specification.', '/knowledge/peptide-specification-annex/'],
      ['OOS (out of specification)', 'A result outside the agreed limits. The response — rejection, investigation or retest — should be defined before you order.', '/knowledge/peptide-procurement-contract-terms/'],
      ['Preparative HPLC', 'Chromatography run to recover material rather than to measure it. Overloaded columns trade resolution for throughput, and the fraction cut sets purity and yield together.', '/knowledge/peptide-purification-and-salt-conversion/'],
      ['Salt conversion', 'Exchanging the counter-ion associated with a peptide — commonly TFA for acetate — without changing the sequence. Each exchanged site shifts salt mass by roughly 54 Da.', '/knowledge/peptide-purification-and-salt-conversion/'],
      ['SEC (size-exclusion chromatography)', 'Separation by hydrodynamic size. Good for stable oligomers; dilution on the column can dissociate weak aggregates.', '/knowledge/peptide-aggregate-analytics/'],
      ['DLS (dynamic light scattering)', 'Derives a hydrodynamic radius from scattered-light fluctuations. Intensity-weighted, so a few large species can dominate the result.', '/knowledge/peptide-aggregate-analytics/'],
      ['AUC (analytical ultracentrifugation)', 'Sedimentation analysis in a centrifugal field. Resolves species in solution without a column, but is slow and specialist.', '/knowledge/peptide-aggregate-analytics/'],
    ],
  },
  {
    name: 'Manufacturing',
    terms: [
      ['SPPS', 'Solid-phase peptide synthesis. The peptide is built stepwise on a resin, then cleaved and purified. Scale and resin choice drive impurity profiles.', '/knowledge/peptide-synthesis-spps-explained/'],
      ['Resin', 'The solid support for SPPS. A change of resin lot can shift coupling efficiency and the impurity profile.', '/knowledge/peptide-synthesis-spps-explained/'],
      ['Cleavage and deprotection', 'The step that releases the peptide from the resin and removes side-chain protecting groups. Incomplete cleavage leaves modified by-products.', '/knowledge/peptide-synthesis-spps-explained/'],
      ['Purification', 'Usually preparative HPLC. Gradient and fraction cutting determine which impurities survive into the final lot.', '/knowledge/peptide-purification-and-salt-conversion/'],
      ['Lyophilization', 'Freeze-drying. Removes water from the purified solution to give a stable cake; the cycle affects moisture and cake structure.', '/knowledge/peptide-lyophilization-explained/'],
      ['Counter-ion', 'The ion paired with the peptide — commonly acetate or TFA. It changes mass, pH and solubility, and should be stated on the specification.', '/knowledge/peptide-counter-ion-forms/'],
      ['Batch / lot', 'A single production run with one batch number. Certificates and retention samples attach to the lot, not to the product name.', '/knowledge/peptide-lot-consistency/'],
      ['Scale-up', 'Moving a synthesis from grams to tens or hundreds of grams. Coupling and purification behaviour change; a successful small run does not guarantee the large one.', '/knowledge/peptide-lot-consistency/'],
    ],
  },
  {
    name: 'Sourcing & commercial',
    terms: [
      ['MOQ', 'Minimum order quantity. Often set per SKU and per packaging format rather than per order.', '/knowledge/peptide-moq-and-pricing-tiers/'],
      ['Tier pricing', 'Unit price steps tied to quantity. Confirm whether tiers apply per SKU or across a mixed order.', '/knowledge/peptide-moq-and-pricing-tiers/'],
      ['RFQ', 'Request for quotation. A useful RFQ lists SKU, strength, quantity, destination and documentation requirements.', '/contact/'],
      ['Incoterms', 'Standard trade terms (EXW, FOB, CIF, DDP) that allocate cost and risk. Name the term and the place in the contract.', '/knowledge/peptide-procurement-contract-terms/'],
      ['HS code', 'Customs classification code. The code determines duty and whether an import permit is required at destination.', '/knowledge/shipping-peptides-customs-guide/'],
      ['T/T (telegraphic transfer)', 'A bank wire payment. Common for first orders; the protection it offers depends on what the payment is conditioned on, not on the transfer itself.', '/knowledge/peptide-supplier-payment-terms/'],
      ['Letter of credit (L/C)', 'A bank undertaking to pay against compliant documents. It protects both sides only if the document set is written precisely and checked strictly.', '/knowledge/peptide-supplier-payment-terms/'],
      ['Beneficiary', 'The account holder receiving a payment. It must match the contracting entity; mismatches are the most common sign of payment fraud in this trade.', '/knowledge/peptide-supplier-payment-terms/'],
      ['Escrow', 'Funds held by a third party and released when agreed milestones are met. Useful for mid-size orders where neither full prepayment nor credit terms is acceptable.', '/knowledge/peptide-supplier-payment-terms/'],
      ['Change control', 'The contractual process for notifying and approving changes to process, site or specification. Its absence is a common source of silent drift.', '/knowledge/peptide-procurement-contract-terms/'],
      ['OEM', 'Original equipment manufacturer. Here: supply under the buyer’s brand, with agreed label and documentation.', '/oem-private-label/'],
      ['Private label', 'A product sold under the buyer’s brand rather than the manufacturer’s. Label rules and registrations differ by market.', '/oem-private-label/'],
      ['Qualification', 'The pre-order process of checking documentation, samples and references before committing to a supplier.', '/knowledge/china-peptide-supplier-checklist/'],
      ['Dual sourcing', 'Qualifying a second supplier for a critical SKU to reduce single-source risk. Requires comparable specifications.', '/knowledge/bulk-peptide-sourcing-risks/'],
      ['Retest date', 'The date to which a supplier warrants the specification, after which the lot must be re-analysed before use. Not the same as an expiry date.', '/knowledge/peptide-inventory-and-retest-dates/'],
      ['Safety stock', 'Inventory held to cover lead-time variability rather than average demand. Scales with the standard deviation of lead time, not with the mean.', '/knowledge/peptide-inventory-and-retest-dates/'],
    ],
  },
  {
    name: 'Handling & logistics',
    terms: [
      ['Lyophilized powder', 'Freeze-dried peptide, typically a porous cake or powder in a sealed vial. More stable in transit than a solution.', '/knowledge/peptide-storage-handling/'],
      ['Reconstitution', 'Dissolving lyophilized peptide in a suitable laboratory solvent. Concentration is calculated from the measured mass, not assumed.', '/knowledge/peptide-reconstitution-guide/'],
      ['Freeze–thaw cycle', 'Repeated freezing and thawing of a solution. Aliquot before freezing to limit damage.', '/knowledge/peptide-reconstitution-guide/'],
      ['Cold chain', 'Temperature-controlled handling from dispatch to delivery. Required for sensitive material; overkill for many lyophilized lots on short routes.', '/knowledge/peptide-cold-chain-logistics/'],
      ['Phase-change pack', 'A pack that holds a temperature band during transit. Check it is still within range on arrival.', '/knowledge/peptide-cold-chain-logistics/'],
      ['Desiccant', 'A moisture absorber included in packaging. It manages humidity, not temperature.', '/knowledge/peptide-packaging-configurations/'],
      ['Aggregation', 'Non-specific clumping of peptide molecules through hydrophobic and charge interactions. It can reduce soluble recovery without changing the certificate.', '/knowledge/peptide-aggregation-self-assembly/'],
      ['Self-assembly', 'Sequence-encoded organisation of peptides into defined structures such as fibrils or gels. A property of the molecule, not a handling error.', '/knowledge/peptide-aggregation-self-assembly/'],
      ['Isoelectric point (pI)', 'The pH at which a peptide carries no net charge and is usually least soluble. Buffer away from it rather than relying on water.', '/knowledge/peptide-aggregation-self-assembly/'],
      ['Headspace', 'The gas volume above the powder in a vial or pouch. Its oxygen and moisture content drive slow degradation; inert-gas flushing reduces it.', '/knowledge/peptide-packaging-configurations/'],
      ['Customs hold', 'Detention of a shipment for inspection or missing documents. Plan for it on time-sensitive orders.', '/knowledge/shipping-peptides-customs-guide/'],
      ['RUO', 'Research use only. A labelling and use restriction: not for human or veterinary use, diagnosis, treatment or cosmetic application.', '/compliance/research-use-only/'],
    ],
  },
];
---
<BaseLayout title="Peptide Sourcing & Quality Glossary" description="Definitions for the terms that decide peptide quality and supply: HPLC, COA, SPPS, counter-ion, MOQ, Incoterms, retention samples and more." canonical="/glossary/">
  <div class="wrap-narrow">
    <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Knowledge',href:'/knowledge/'},{label:'Glossary'}]} />
    <h1>Glossary</h1>
    <p class="lead muted">Short, practical definitions for the vocabulary used in peptide sourcing, analytics and logistics. Each entry links to the guide that covers it in depth.</p>

    {groups.map(g => (
      <section>
        <h2>{g.name}</h2>
        <dl>
          {g.terms.map(([term, def, href]) => (
            <div style="margin:0 0 14px;">
              <dt style="font-weight:650;color:var(--navy);">{term}</dt>
              <dd style="margin:2px 0 0;">{def} <a href={href}>Read more</a></dd>
            </div>
          ))}
        </dl>
      </section>
    ))}

    <div class="ruo">Research use only. Definitions describe laboratory and commercial practice; they are not medical or regulatory advice.</div>

    <h2>Related</h2>
    <ul>
      <li><a href="/knowledge/">All knowledge guides</a></li>
      <li><a href="/quality/">Quality framework</a></li>
      <li><a href="/products/">Product catalogue</a></li>
    </ul>
  </div>
  <ArticleSchema title="Peptide Sourcing & Quality Glossary" description="Definitions for the terms that decide peptide quality and supply: HPLC, COA, SPPS, counter-ion, MOQ, Incoterms and retention samples." path="/glossary/" section="Peptide sourcing glossary" />
</BaseLayout>
