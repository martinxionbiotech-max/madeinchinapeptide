---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/articles';
const clusters = [...new Set(articles.map(a => a.cluster))];
---
<BaseLayout title="Knowledge Base — Research Peptide Sourcing & Quality" description="Technical guides on peptide purity, storage, supplier evaluation and bulk procurement from China." canonical="/knowledge/">
  <div class="wrap">
    <p class="breadcrumb"><a href="/">Home</a> › Knowledge</p>
    <h1>Knowledge base</h1>
    <p class="lead muted" style="max-width:800px;">Practical, evidence-oriented guides for buyers of research peptides: how to read analytical data, how to store material, and how to evaluate a supplier without visiting the factory.</p>
    <section style="margin-top:32px;">
      <h2>Comparisons</h2>
      <div class="grid grid-2">
        <div class="card">
          <h3><a href="/compare/china-vs-us-peptide-suppliers/">China vs US peptide suppliers</a></h3>
          <p>What actually differs — documentation, lead time, price structure and risk.</p>
        </div>
        <div class="card">
          <h3><a href="/compare/peptide-purity-grades/">Peptide purity grades explained</a></h3>
          <p>What 95%, 98% and 99% mean analytically, and which grade fits which use.</p>
        </div>
      </div>
    </section>
    {clusters.map(c => (
      <section style="margin-top:32px;">
        <h2>{c}</h2>
        <div class="grid grid-2">
          {articles.filter(a => a.cluster === c).map(a => (
            <div class="card">
              <h3><a href={`/knowledge/${a.slug}/`}>{a.title}</a></h3>
              <p>{a.desc}</p>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
