<BaseLayout lang="pt" title={title} description={description} canonical="/pt/knowledge/peptide-batch-documentation-package/" alternates={[{hreflang:'en',href:'https://madeinchinapeptide.com/knowledge/peptide-batch-documentation-package/'},{hreflang:'es',href:'https://madeinchinapeptide.com/es/knowledge/peptide-batch-documentation-package/'},{hreflang:'pt',href:'https://madeinchinapeptide.com/pt/knowledge/peptide-batch-documentation-package/'},{hreflang:'ar',href:'https://madeinchinapeptide.com/ar/knowledge/peptide-batch-documentation-package/'},{hreflang:'x-default',href:'https://madeinchinapeptide.com/knowledge/peptide-batch-documentation-package/'}]}>
