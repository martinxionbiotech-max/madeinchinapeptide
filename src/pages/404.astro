---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Made in China Peptide" description="The page you requested does not exist. Browse the research peptide catalogue, the knowledge base, or contact the sales team for a quotation." canonical="/404/" noindex={true}>
  <div class="wrap-narrow" style="padding:64px 0;">
    <p class="tag">404</p>
    <h1>That page doesn’t exist</h1>
    <p class="lead muted">The URL may have changed, or the link may contain a typo. The catalogue and the knowledge base are the two places most visitors are looking for.</p>
    <div class="grid grid-2" style="margin-top:24px;">
      <div class="card">
        <h3><a href="/products/">Research peptide catalogue</a></h3>
        <p>Tirzepatide, semaglutide, retatrutide and the research peptide range, with strengths and documentation.</p>
      </div>
      <div class="card">
        <h3><a href="/knowledge/">Knowledge base</a></h3>
        <p>Guides on purity verification, COA review, storage, shipping and supplier evaluation.</p>
      </div>
    </div>
    <p style="margin-top:24px;">Need a quotation or a batch COA? <a href="/contact/">Contact the sales team</a>.</p>
  </div>
</BaseLayout>
