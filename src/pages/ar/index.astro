---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
---
<BaseLayout lang="ar" title="Made in China Peptide — ببتيدات بحثية بالجملة" description="قناة توريد B2B لببتيدات البحث المصنوعة في الصين: شهادة تحليل لكل دفعة، بيانات HPLC/MS، توريد بالجملة وبرامج OEM." canonical="/ar/" alternates={[{hreflang:'en',href:'https://madeinchinapeptide.com/'},{hreflang:'es',href:'https://madeinchinapeptide.com/es/'},{hreflang:'ar',href:'https://madeinchinapeptide.com/ar/'},{hreflang:'pt',href:'https://madeinchinapeptide.com/pt/'},{hreflang:'x-default',href:'https://madeinchinapeptide.com/'}]}>
  <section class="hero">
    <div class="wrap">
      <span class="badge">للاستخدام البحثي فقط · توريد B2B</span>
      <h1>ببتيدات بحثية من الصين، موثّقة دفعة بدفعة.</h1>
      <p class="lead">قناة توريد للمختبرات والموزعين والعلامات التجارية تحتاج أكثر من قائمة أسعار: شهادة تحليل لكل دفعة، بيانات HPLC، تتبّع، وتوريد بالجملة.</p>
      <p style="margin-top:24px;"><a class="btn" href="/products/">تصفح الكتالوج</a> <a class="btn btn-ghost" href="/wholesale/" style="margin-left:10px;">الجملة</a></p>
      <p class="small muted" style="margin-top:18px;">{site.ruo}</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2>لماذا نعمل معنا</h2>
      <div class="grid grid-3">
        <div class="card"><h3>التوثيق أولاً</h3><p>كل دفعة مع شهادة تحليل، كروماتوغرام HPLC وتأكيد MS. رقم الدفعة قابل للتتبّع.</p></div>
        <div class="card"><h3>توريد بالجملة</h3><p>أحجام قوارير وكميات بالغرام بأسعار متدرجة للموزعين والمختبرات المؤهلة.</p></div>
        <div class="card"><h3>OEM وعلامة خاصة</h3><p>ملصقات وعلب وحزم توثيق مخصصة للعلامات التجارية.</p></div>
      </div>
      <p style="margin-top:24px;"><a class="wa-btn" href={site.whatsappLink} target="_blank" rel="noopener">💬 واتساب</a></p>
    </div>
  </section>
  <section class="section section-soft">
    <div class="wrap">
      <h2>منتجات مميزة</h2>
      <ul>
        <li><a href="/products/tirzepatide/">تيرزيباتيد</a> — 2–60 مغ</li>
        <li><a href="/products/semaglutide/">سيماغلوتيد</a> — 2–50 مغ</li>
        <li><a href="/products/retatrutide/">ريتاتروتيد</a> — 5–60 مغ</li>
        <li><a href="/products/research/">ببتيدات بحثية</a> — BPC-157، TB-500، CJC-1295</li>
        <li><a href="/products/cosmetic/">ببتيدات تجميلية</a> — GHK-Cu، غلوتاثيون</li>
      </ul>
      <p class="small muted">النقاء خاص بكل دفعة ويُذكر في شهادة التحليل الخاصة بها. اطلب عينة شهادة قبل الشراء.</p>
    </div>
  </section>
</BaseLayout>
