---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
---
<BaseLayout title="Privacy Policy — Made in China Peptide" description="How we collect, use and protect business contact and order information, how long we keep it, and how to request deletion." canonical="/compliance/privacy/">
  <div class="wrap-narrow">
    <p class="breadcrumb"><a href="/">Home</a> › Compliance › Privacy</p>
    <h1>Privacy Policy</h1>
    <p class="small muted">Last updated: 2026-11-04</p>

    <h2>What we collect</h2>
    <ul>
      <li>Business contact details (name, company, email, phone/WhatsApp)</li>
      <li>Order information (products, quantities, shipping address, invoices)</li>
      <li>Technical correspondence related to quotations and quality documents</li>
      <li>Basic website analytics (pages viewed, referrer, approximate region)</li>
    </ul>

    <h2>How we use it</h2>
    <p>To respond to enquiries, prepare quotations, fulfil orders, provide documentation and comply with legal obligations. We do not sell personal data.</p>

    <h2>Sharing</h2>
    <p>Data is shared only with service providers necessary to fulfil an order (logistics, payment, customs brokers) or where required by law.</p>

    <h2>Retention</h2>
    <p>Order and quality records are retained for the period required by applicable trade and quality regulations. Marketing contacts are removed on request.</p>

    <h2>Your rights</h2>
    <p>You may request access, correction or deletion of your business contact data by emailing <a href={`mailto:${site.email}`}>{site.email}</a>.</p>

    <h2>Cookies</h2>
    <p>This site uses only essential cookies and, where enabled, privacy-respecting analytics. No advertising trackers are used.</p>
  </div>
</BaseLayout>
