---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { products, categories, type Category } from '../../../data/products';
import { site } from '../../../data/site';
export function getStaticPaths() {
  return products.map((p) => ({ params: { category: p.category, slug: p.slug } }));
}
const { category, slug } = Astro.params as { category: Category; slug: string };
const p = products.find(x => x.slug === slug)!;
const cat = categories[category];
const mgOf = (s: string) => { const m = s.match(/([\d.]+)\s*mg/); return m ? parseFloat(m[1]) : NaN; };
const myMg = mgOf(p.strength);
const sibs = products.filter(x => x.category === category && x.slug !== p.slug)
  .map(x => ({ x, mg: mgOf(x.strength) })).filter(o => !isNaN(o.mg)).sort((a,b) => a.mg - b.mg);
const lower = !isNaN(myMg) ? [...sibs].filter(o => o.mg < myMg).pop() : undefined;
const higher = !isNaN(myMg) ? sibs.find(o => o.mg > myMg) : undefined;

const reading: Record<Category, { href: string; label: string }[]> = {
  tirzepatide: [
    { href: '/knowledge/how-to-verify-peptide-purity/', label: 'How to verify purity before you buy' },
    { href: '/knowledge/peptide-lot-consistency/', label: 'Lot-to-lot consistency' },
    { href: '/knowledge/peptide-cold-chain-logistics/', label: 'Cold chain and transit' },
  ],
  semaglutide: [
    { href: '/knowledge/how-to-verify-peptide-purity/', label: 'How to verify purity before you buy' },
    { href: '/knowledge/peptide-lot-consistency/', label: 'Lot-to-lot consistency' },
    { href: '/knowledge/peptide-coa-red-flags/', label: 'COA red flags' },
  ],
  retatrutide: [
    { href: '/knowledge/glp-1-research-peptides-compared/', label: 'Semaglutide vs tirzepatide vs retatrutide' },
    { href: '/knowledge/how-to-verify-peptide-purity/', label: 'How to verify purity before you buy' },
    { href: '/knowledge/peptide-coa-red-flags/', label: 'COA red flags' },
  ],
  research: [
    { href: '/knowledge/peptide-reconstitution-guide/', label: 'Reconstitution practice' },
    { href: '/knowledge/peptide-storage-handling/', label: 'Storage and handling' },
    { href: '/knowledge/peptide-synthesis-spps-explained/', label: 'How the peptide is made' },
  ],
  cosmetic: [
    { href: '/knowledge/how-to-verify-peptide-purity/', label: 'How to verify purity before you buy' },
    { href: '/knowledge/peptide-storage-handling/', label: 'Storage and handling' },
    { href: '/knowledge/peptide-procurement-contract-terms/', label: 'Procurement contract terms' },
  ],
  accessories: [
    { href: '/knowledge/peptide-reconstitution-guide/', label: 'Reconstitution practice' },
    { href: '/knowledge/peptide-storage-handling/', label: 'Storage and handling' },
    { href: '/knowledge/peptide-coa-red-flags/', label: 'COA red flags' },
  ],
};
const fullTitle = `${p.name} — Bulk & OEM Supply | Made in China Peptide`;
// Keep the SERP title inside ~65 characters; long compound names fall back to a shorter suffix.
const seoTitle = fullTitle.length > 65 ? `${p.name} — Bulk & OEM` : fullTitle;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  description: p.summary,
  brand: { '@type': 'Brand', name: 'Made in China Peptide' },
  category: 'Research chemicals',
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Strength', value: p.strength },
    { '@type': 'PropertyValue', name: 'Form', value: p.form },
    { '@type': 'PropertyValue', name: 'Purity', value: p.purity },
    { '@type': 'PropertyValue', name: 'Storage', value: p.storage },
    { '@type': 'PropertyValue', name: 'MOQ', value: p.moq },
  ],
  url: `https://madeinchinapeptide.com/products/${category}/${slug}/`,
  audience: { '@type': 'BusinessAudience', audienceType: 'Research laboratories and distributors' },
  offers: {
    '@type': 'Offer',
    url: `https://madeinchinapeptide.com/products/${category}/${slug}/`,
    priceCurrency: 'USD',
    price: p.price,
    priceValidUntil: '2027-12-31',
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: { '@type': 'Organization', name: 'Made in China Peptide' },
  },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: `Is ${p.name} for human use?`, acceptedAnswer: { '@type': 'Answer', text: 'No. It is supplied for laboratory research only, not for human or veterinary use.' } },
    { '@type': 'Question', name: 'What documentation ships with the order?', acceptedAnswer: { '@type': 'Answer', text: 'A batch-specific COA with HPLC chromatogram and method, MS confirmation, MSDS and storage instructions.' } },
    { '@type': 'Question', name: 'Can I order a sample before a bulk order?', acceptedAnswer: { '@type': 'Answer', text: 'Yes, for qualified business buyers. The sample ships with its own batch COA.' } },
  ],
};

---
<BaseLayout title={seoTitle} description={`${p.name} — ${p.form.toLowerCase()} for laboratory research. Batch-specific COA with HPLC and MS data; bulk and OEM supply.`} canonical={`/products/${category}/${slug}/`}>
  <div class="wrap">
    <Breadcrumbs items={[{label:"Home",href:"/"},{label:"Products",href:"/products/"},{label:cat.name,href:`/products/${category}/`},{label:p.name}]} />
    <h1>{p.name}</h1>
    <p class="price-line">Indicative price: <strong>{p.price} USD</strong> per vial · bulk tiers quoted on request</p>
    <div class="quick-answer"><strong>Quick answer.</strong> {p.name} is supplied as {p.form.toLowerCase()} for laboratory research, with a batch-specific COA (HPLC chromatogram + MS confirmation). MOQ {p.moq}; lead time {p.leadTime}. <a href={site.whatsappLink} target="_blank" rel="noopener">Ask on WhatsApp</a>.</div>

    <div class="grid grid-2" style="align-items:start;gap:32px;">
      <div>
        <p class="lead muted" style="max-width:800px;">{p.summary}</p>
        <p style="margin:20px 0 6px;">
          <a class="btn" href="/contact/">Request quotation &amp; batch COA</a>
          <a class="btn btn-ghost" href="/wholesale/" style="margin-left:8px;">Bulk pricing</a>
        </p>
        <p class="tiny muted">Include target quantity, destination country and any documentation your QC requires.</p>
      </div>
      <div>
        <img src={p.image ?? `/images/products/vial-${category}.svg`} alt={`${p.name} — research-grade vial`} width="640" height="640" style="max-width:280px;width:100%;height:auto;border:1px solid var(--line);border-radius:12px;background:#fff;" loading="lazy" />
        <p class="tiny muted" style="margin-top:8px;">{p.image ? 'Product photograph. Label and batch details may vary by lot.' : 'Illustrative image. Actual vial and label may differ by batch and packaging option.'}</p>
      </div>
    </div>

    <h2>Specifications</h2>
    <table>
      <tbody>
        <tr><th style="width:220px;">Product</th><td>{p.name}</td></tr>
        <tr><th>Strength</th><td>{p.strength}</td></tr>
        <tr><th>Form</th><td>{p.form}</td></tr>
        {p.cas && <tr><th>CAS number</th><td>{p.cas}</td></tr>}
        {p.mw && <tr><th>Molecular weight</th><td>{p.mw}</td></tr>}
        <tr><th>Purity</th><td>{p.purity}</td></tr>
        <tr><th>Storage</th><td>{p.storage}</td></tr>
        <tr><th>Packaging</th><td>{p.packaging}</td></tr>
        <tr><th>MOQ</th><td>{p.moq}</td></tr>
        <tr><th>Lead time</th><td>{p.leadTime}</td></tr>
        <tr><th>Indicative price</th><td>{p.price} USD per vial (bulk tiers on request)</td></tr>
        <tr><th>Documentation</th><td>{p.docs.join(' · ')}</td></tr>
      </tbody>
    </table>

    {p.note && (<><h2>Lot notes</h2><p>{p.note}</p></>)}

    {!isNaN(myMg) && (lower || higher) && (
      <><h2>Range context</h2>
      <p>
        This {p.strength} format sits {lower ? <>above <a href={`/products/${category}/${lower.x.slug}/`}>{lower.x.name}</a></> : 'at the low end of the range'} {higher ? <>and below <a href={`/products/${category}/${higher.x.slug}/`}>{higher.x.name}</a></> : 'at the top of the range'}.
        It is packaged as {p.packaging.toLowerCase()} with an MOQ of {p.moq} and a typical lead time of {p.leadTime}.
      </p></>
    )}

    <h2>Documentation &amp; batch traceability</h2>
    <p>Each production lot is assigned a batch number that links to its certificate of analysis, HPLC chromatogram and mass-spec confirmation. We do not publish a single "typical" purity figure as if it applied to every lot — the COA for the specific batch is the authoritative document. Request a sample COA before purchase.</p>

    <h2>Bulk &amp; wholesale pricing</h2>
    <p>Pricing is quantity-tiered and depends on strength, packaging and destination. Standard tiers start at {p.moq}; distributor and OEM volumes are quoted individually. <a href="/wholesale/">See how wholesale ordering works</a> or <a href="/contact/">request a quotation</a>.</p>

    <h2>Handling notes</h2>
    <ul>
      <li>Store lyophilized material at −20 °C, protected from light and moisture.</li>
      <li>Allow vials to reach room temperature before opening to avoid condensation.</li>
      <li>Reconstitute only with appropriate laboratory-grade solvent for in-vitro work; do not use for injection.</li>
      <li> Aliquot reconstituted material to avoid repeated freeze–thaw cycles.</li>
    </ul>
    <p class="small muted">Preparing a stock solution? The <a href="/tools/reconstitution-calculator/">reconstitution calculator</a> converts fill mass and diluent volume into mg/mL and µM, with purity correction.</p>

    <div class="ruo" style="margin:28px 0;">{p.name} is supplied for laboratory research use only. It is not a drug, food, cosmetic or veterinary product and must not be administered to humans or animals.</div>

    {cat.take && (
      <>
        <h2 id="authors-take">The Author's Take</h2>
        <p><strong>Position.</strong> {cat.take.position}</p>
        <p><strong>Reasoning.</strong> {cat.take.reasoning}</p>
        <p class="small muted"><strong>Disclosure.</strong> {cat.take.disclosure}</p>
      </>
    )}

    <h2>Related products</h2>
    <ul>
      {products.filter(x => x.category === category && x.slug !== p.slug).slice(0, 5).map(x => (
        <li><a href={`/products/${x.category}/${x.slug}/`}>{x.name}</a> — {x.strength}, {x.form.toLowerCase()}</li>
      ))}
    </ul>

    <h2>Further reading</h2>
    <ul>
      {reading[category].map(r => <li><a href={r.href}>{r.label}</a></li>)}
    </ul>

    <h2>Frequently asked</h2>
    <h3>Is {p.name} for human use?</h3>
    <p>No. It is supplied for laboratory research only — not for human or veterinary use, diagnosis, treatment or cosmetic application.</p>
    <h3>What documentation ships with the order?</h3>
    <p>A batch-specific COA with HPLC chromatogram and method, MS confirmation, MSDS and storage instructions. The batch number on the COA matches the vial label and invoice.</p>
    <h3>Can I order a sample before a bulk order?</h3>
    <p>Yes, for qualified business buyers. The sample ships with its own batch COA so you can verify identity and documentation before committing to volume.</p>
    <p><a class="wa-btn" href={site.whatsappLink} target="_blank" rel="noopener">💬 Ask about {p.name} on WhatsApp</a></p>

    <h2>Related</h2>
    <p>
      <a href={`/products/${category}/`}>All {cat.name}</a> ·
      <a href="/quality/">Quality &amp; testing</a> ·
      <a href="/knowledge/china-peptide-sourcing-framework/">Sourcing framework</a> ·
      <a href="/knowledge/peptide-quality-verification-framework/">Quality verification framework</a> ·
      <a href="/knowledge/peptide-handling-laboratory-practice/">Handling framework</a> ·
      <a href="/knowledge/">Research knowledge base</a>
    </p>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</BaseLayout>
