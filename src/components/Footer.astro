---
import { site } from '../data/site';
const langMatch = Astro.url.pathname.match(/^\/(es|pt|ar)(\/|$)/);
const lang = langMatch ? langMatch[1] : null;
const localizedLegal = {
  es: [
    { label: 'Centro de cumplimiento', href: '/es/compliance/' },
    { label: 'Uso exclusivo en investigación', href: '/es/compliance/research-use-only/' },
    { label: 'Términos del servicio', href: '/es/compliance/terms/' },
    { label: 'Política de privacidad', href: '/es/compliance/privacy/' },
    { label: 'Política de cookies', href: '/es/compliance/cookie-policy/' },
    { label: 'Envío y aduanas', href: '/es/compliance/shipping-customs/' },
    { label: 'Devoluciones', href: '/es/compliance/returns/' },
    { label: 'Accesibilidad', href: '/es/compliance/accessibility/' },
  ],
  pt: [
    { label: 'Centro de conformidade', href: '/pt/compliance/' },
    { label: 'Uso exclusivo em pesquisa', href: '/pt/compliance/research-use-only/' },
    { label: 'Termos de serviço', href: '/pt/compliance/terms/' },
    { label: 'Política de privacidade', href: '/pt/compliance/privacy/' },
    { label: 'Política de cookies', href: '/pt/compliance/cookie-policy/' },
    { label: 'Envio e alfândega', href: '/pt/compliance/shipping-customs/' },
    { label: 'Devoluções', href: '/pt/compliance/returns/' },
    { label: 'Acessibilidade', href: '/pt/compliance/accessibility/' },
  ],
  ar: [
    { label: 'مركز الامتثال', href: '/ar/compliance/' },
    { label: 'الاستخدام البحثي فقط', href: '/ar/compliance/research-use-only/' },
    { label: 'شروط الخدمة', href: '/ar/compliance/terms/' },
    { label: 'سياسة الخصوصية', href: '/ar/compliance/privacy/' },
    { label: 'سياسة الكوكيز', href: '/ar/compliance/cookie-policy/' },
    { label: 'الشحن والجمارك', href: '/ar/compliance/shipping-customs/' },
    { label: 'الإرجاع', href: '/ar/compliance/returns/' },
    { label: 'إمكانية الوصول', href: '/ar/compliance/accessibility/' },
  ],
};
const year = new Date().getFullYear();
const links = [
  { label: 'Products', href: '/products/' },
  { label: 'Wholesale', href: '/wholesale/' },
  { label: 'OEM / Private Label', href: '/oem-private-label/' },
  { label: 'Quality', href: '/quality/' },
  { label: 'Factory & QC', href: '/factory/' },
  { label: 'Knowledge', href: '/knowledge/' },
  { label: 'MCP TechTeam', href: '/author/mcp-tech-team/' },
  { label: 'Lab tools', href: '/tools/' },
  { label: 'For laboratories', href: '/applications/laboratories/' },
  { label: 'For distributors', href: '/applications/distributors/' },
  { label: 'For formulators', href: '/applications/formulators/' },
  { label: 'For OEM brands', href: '/applications/oem-brands/' },
  { label: 'Catalogue matrix', href: '/compare/peptide-catalogue-matrix/' },
];
const legal = lang ? localizedLegal[lang as keyof typeof localizedLegal] : [
  { label: 'Compliance centre', href: '/compliance/' },
  { label: 'Research Use Only', href: '/compliance/research-use-only/' },
  { label: 'Terms of Service', href: '/compliance/terms/' },
  { label: 'Privacy Policy', href: '/compliance/privacy/' },
  { label: 'Cookie Policy', href: '/compliance/cookie-policy/' },
  { label: 'Shipping & Customs', href: '/compliance/shipping-customs/' },
  { label: 'Returns', href: '/compliance/returns/' },
  { label: 'Accessibility', href: '/compliance/accessibility/' },
];
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <h4>{site.brand}</h4>
        <p class="small" style="color:#a9bccf;max-width:34ch;">{site.tagline}</p>
        <p class="tiny" style="color:#8fa3b8;">Operated by {site.legalName}. {site.ruo}</p>
      </div>
      <div>
        <h4>Company</h4>
        <ul>{links.map(l => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
      <div>
        <h4>Compliance</h4>
        <ul>{legal.map(l => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <li><strong>Sales:</strong> <a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><strong>Technical:</strong> <a href="mailto:martin@madeinchinapeptide.com">martin@madeinchinapeptide.com</a></li>
          <li><strong>Admin:</strong> <a href="mailto:admin@madeinchinapeptide.com">admin@madeinchinapeptide.com</a></li>
          <li><a class="wa-btn" href={site.whatsappLink} target="_blank" rel="noopener">💬 WhatsApp</a></li>
          <li>{site.address}</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      &copy; {year} {site.legalName}. {site.brand} is a trading name of {site.legalName}. All rights reserved. Products are supplied for laboratory research use only.
    </div>
  </div>
</footer>
